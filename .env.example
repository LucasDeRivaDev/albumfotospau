# ─────────────────────────────────────────────
# SUPABASE — conseguís estas variables en:
# https://app.supabase.com → tu proyecto → Settings → API
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────
# CLOUDFLARE R2 — URL pública de tu bucket
# Opción A: URL de desarrollo de R2 (habilitar en dashboard de CF)
#   https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Opción B: Dominio propio conectado a R2
#   https://fotos.tudominio.com
# ─────────────────────────────────────────────
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ─────────────────────────────────────────────
# SCRIPT DE UPLOAD (solo se usa en scripts/upload.js, NO en el frontend)
# Estas variables NO tienen prefijo VITE_ — nunca llegan al browser
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=albumpau-fotos

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
